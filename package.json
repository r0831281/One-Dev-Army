{
  "name": "one-developer-army",
  "version": "0.4.0",
  "private": true,
  "description": "Local-first setup and task-ingestion platform for One Developer Army",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node tools/clean.mjs",
    "check": "pnpm check:markdown && pnpm check:docs && pnpm check:contracts && pnpm check:phase2-artifacts && pnpm check:phase3-artifacts && pnpm check:phase4-artifacts && pnpm typecheck && pnpm test",
    "check:markdown": "markdownlint-cli2 README.md docs/**/*.md",
    "check:types": "tsc --project tsconfig.reference.json",
    "check:docs": "node tools/validate-docs.mjs",
    "check:diagrams": "node tools/render-diagrams.mjs",
    "check:contracts": "node tools/generate-contracts.mjs --check",
    "check:phase2-artifacts": "node tools/validate-phase2-artifacts.mjs",
    "check:phase3-artifacts": "node tools/validate-phase3-artifacts.mjs",
    "check:phase4-artifacts": "node tools/validate-phase4-artifacts.mjs",
    "generate:contracts": "node tools/generate-contracts.mjs --write",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit && eslint eslint.config.js tools/*.mjs --max-warnings 0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "pnpm build && node --test dist/tests/*.test.js",
    "demo": "pnpm build && node dist/packages/cli/src/bin.js demo",
    "demo:dashboard": "node tools/dashboard-preview.mjs",
    "demo:phase2": "pnpm build && node tools/verify-phase2.mjs --demo",
    "worker": "pnpm build && node dist/apps/worker/src/index.js",
    "api": "pnpm build && node dist/apps/api/src/server.js",
    "verify:phase2": "pnpm build && node tools/verify-phase2.mjs",
    "verify:phase3": "pnpm build && node tools/verify-phase3.mjs",
    "verify:phase3:services": "pnpm build && node tools/verify-phase3-postgres.mjs && node tools/verify-phase3-temporal.mjs",
    "demo:phase3": "pnpm build && node tools/verify-phase3.mjs",
    "export:phase3": "node tools/export-phase3.mjs",
    "retain:phase3": "node tools/retain-phase3.mjs",
    "verify:phase4": "pnpm build && node tools/verify-phase4.mjs && node tools/verify-phase4-dashboard.mjs",
    "release:phase4": "node tools/release-phase4.mjs",
    "drill:phase4": "node tools/phase4-operations.mjs drill --output .validation/phase4-drill",
    "doctor": "pnpm build && node dist/packages/cli/src/bin.js doctor",
    "release:connectors": "node tools/release-connectors.mjs",
    "verify:connector-artifacts": "node tools/verify-connector-artifacts.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@eslint/js": "9.39.1",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.1",
    "json-schema-to-typescript": "16.0.0",
    "markdownlint-cli2": "0.24.0",
    "mermaid": "11.12.0",
    "prettier": "3.6.2",
    "puppeteer-core": "24.24.1",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@temporalio/activity": "1.25.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/common": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "@temporalio/workflow": "1.25.0",
    "hash-wasm": "4.12.0",
    "pg": "8.13.1"
  }
}
